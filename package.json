{
  "name": "esyasoft-onboarding-react-final",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/express": "latest",
    "@clerk/react": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "resend": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "@types/cors": "^2.8.19"
  },
  "engines": {
    "node": ">=20"
  }
}
